{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./orchestrator/.env)",
      "Read(./edge/.dev.vars)",
      "Bash(git push --force *)",
      "Bash(git push origin main)"
    ]
  }
}
