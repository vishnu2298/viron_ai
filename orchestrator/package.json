{
  "name": "viron-ai-orchestrator",
  "version": "0.1.0",
  "description": "Viron AI runtime: serves Viron tiers with adapters and retrieval, least compute per request",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test test/*.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage --test-coverage-include=\"src/services/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "mongodb": "^6.9.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
