# Orchestrator settings. Standalone: there are no external AI API keys to set.
NODE_ENV=production
PORT=8080
# Required in production: a random secret you generate (>= 32 chars). Startup refuses the placeholder below.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value as the edge's ORIGIN_API_KEY (wrangler secret put ORIGIN_API_KEY).
ORCHESTRATOR_API_KEY=change-me

# Reverse proxy / Cloudflare (see README "Behind a proxy")
TRUST_PROXY=false
TRUST_CF_IP=false

# Confidence gate (tune with /api/v1/stats)
CONF_MIN_MEAN_LOGPROB=-0.9
CONF_LOW_TOKEN_LOGPROB=-2.5
CONF_MAX_LOW_TOKEN_RATIO=0.15

# Leave EMBED_URL unset for MongoDB text search (no pretrained embedder; see README)
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.55
MONGODB_DB=viron_ai
