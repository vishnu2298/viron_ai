NODE_ENV=production
PORT=8080
ORCHESTRATOR_API_KEY=change-me

# Escalation tier (only called when local tiers are not confident)
ESCALATION_ENABLED=true
ANTHROPIC_API_KEY=
ESCALATION_MODEL=claude-sonnet-5-5

# Confidence gate (tune with /api/v1/stats)
CONF_MIN_MEAN_LOGPROB=-0.9
CONF_LOW_TOKEN_LOGPROB=-2.5
CONF_MAX_LOW_TOKEN_RATIO=0.15

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.55
MONGODB_DB=viron_ai
